# Briefly AI — Template de variables d'environnement
# USAGE: cp env.example .env   (puis adapter les valeurs localement)
# Ce fichier est versionné (aucun secret réel).
# Secrets réels → .env.local (ignoré par git)

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=changeme_dev_only_replace_in_production_with_32char_random_hex
###< symfony/framework-bundle ###

###> doctrine/doctrine-bundle ###
# Host "database" = nom du service Docker (coherent avec compose.yaml service name)
DATABASE_URL="postgresql://briefly:briefly@database:5432/briefly?serverVersion=16&charset=utf8"
###< doctrine/doctrine-bundle ###

###> Redis — cache, sessions, messenger, rate-limiting ###
# Host "redis" = nom du service Docker (coherent avec compose.yaml service name)
REDIS_URL="redis://redis:6379"
###< Redis ###

###> symfony/messenger ###
# Transport: Redis Streams (ADR-006, tech-spec §9)
MESSENGER_TRANSPORT_DSN="redis://redis:6379/messages"
###< symfony/messenger ###

###> symfony/lock ###
LOCK_DSN="redis://redis:6379"
###< symfony/lock ###

###> PostgreSQL credentials — Docker Compose ###
POSTGRES_DB=briefly
POSTGRES_USER=briefly
POSTGRES_PASSWORD=briefly
###< PostgreSQL credentials ###

###> LLM Providers — placeholder uniquement, jamais de valeurs reelles (constitution §6) ###
MISTRAL_API_KEY=
OPENAI_API_KEY=
###< LLM Providers ###

###> Stripe Billing (ADR-005) ###
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
###< Stripe Billing ###

###> OAuth Providers — US-031 (ADR-005) ###
# Google OAuth2 : créer une app sur https://console.cloud.google.com/apis/credentials
# Redirect URI à whitelister : http://localhost:8000/oauth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GitHub OAuth App : créer sur https://github.com/settings/developers
# Callback URL à configurer : http://localhost:8000/oauth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
###< OAuth Providers ###

###> JWT — EdDSA uniquement (constitution §6, jamais HS256) ###
JWT_PASSPHRASE=changeme_dev_passphrase_32chars_minimum
###< JWT ###
